[Unit]
Description=ChemGraph MCP HTTP server (streamable-HTTP bridge + /artifacts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chemgraph
Group=chemgraph
WorkingDirectory=/opt/chemgraph
Environment=CHEMGRAPH_DIR=/opt/chemgraph
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/chemgraph/.venv/bin/python /opt/chemgraph/chemgraph-mcp-http/mcp_http_server.py --module chemgraph.mcp.mcp_tools --host 0.0.0.0 --port 9003
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
